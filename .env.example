# --- Required ---

# Long random string used to sign admin session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# Credentials for the single admin account. Leave these blank until you're
# ready to set your real email/password — the server only auto-creates the
# account the FIRST time it ever starts against an empty database, so if
# these are filled with placeholder values when that happens, you'll get an
# account you didn't mean to create and can't sign in with your real ones.
#
# If that already happened (login says "Invalid email or password" even
# though these look right), run `npm run admin:set` — it applies whatever
# is in ADMIN_EMAIL/ADMIN_PASSWORD to the admin account regardless of what
# was seeded before.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Optional ---

# Where the SQLite database file lives. Defaults to ./data/bread-forge.db
# DATABASE_PATH=./data/bread-forge.db

# SMTP settings for the "forgot password" email. If left unset, the reset
# link is printed to the server console instead (fine for local dev).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="The Bread Forge <no-reply@thebreadforge.org>"
