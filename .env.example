# --- Required ---

# Long random string used to sign admin session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# Credentials for the single admin account. Only used to auto-create the
# account the first time the server starts with an empty database — after
# that, change the password from the Forgot Password flow, not here.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-launch

# --- Optional ---

# Where the SQLite database file lives. Defaults to ./data/bread-forge.db
# DATABASE_PATH=./data/bread-forge.db

# SMTP settings for the "forgot password" email. If left unset, the reset
# link is printed to the server console instead (fine for local dev).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="The Bread Forge <no-reply@thebreadforge.org>"
